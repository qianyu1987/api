NODE_ENV=production
HOST=0.0.0.0
PORT=3000
PUBLIC_BASE_URL=https://api.hhtc.top
# Compose uses this value for PostgreSQL and builds DATABASE_URL from it.
# Use URL-safe random characters (for example: openssl rand -hex 24).
# POSTGRES_PASSWORD=replace-with-a-long-random-hex-value
DATABASE_URL=postgres://relay:change-me@postgres:5432/relay_station
REDIS_URL=redis://redis:6379
# Optional comma-separated browser origins. Leave empty for same-origin only.
CORS_ORIGINS=
JWT_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECRET=replace-with-at-least-32-random-characters
API_KEY_PEPPER=replace-with-at-least-32-random-characters
CHANNEL_ENCRYPTION_KEY=base64-encoded-32-byte-key
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-before-first-start

# Optional official payment configuration. The API remains unavailable until
# the matching credentials are supplied. Compose mounts ./secrets read-only at
# /run/secrets/relay; keep private material there and out of the image.
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_MCH_SERIAL=
WECHAT_PRIVATE_KEY_PATH=
WECHAT_API_V3_KEY=
WECHAT_PLATFORM_CERT_PATH=
# Leave blank to derive from PUBLIC_BASE_URL.
WECHAT_NOTIFY_URL=
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY_PATH=
ALIPAY_PUBLIC_KEY_PATH=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_NOTIFY_URL=

CHATGPT_DOWNLOAD_URL=https://chatgpt.com/download/
CCSWITCH_DOWNLOAD_URL=https://github.com/farion1231/cc-switch/releases/latest
USAGE_RETENTION_DAYS=90
DEFAULT_AFFILIATE_RATE_BPS=1000
